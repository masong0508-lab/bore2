set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_C_COMPILER clang)
set(CMAKE_ASM_COMPILER clang)
set(CMAKE_AR llvm-ar)
set(CMAKE_RANLIB llvm-ranlib)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(TARGET_COMPILE_OPTIONS --target=armv5te-none-eabi -mcpu=arm946e-s -marm -mfloat-abi=soft -nostdlib)
set(CMAKE_C_FLAGS "--target=armv5te-none-eabi -mcpu=arm946e-s -marm -mfloat-abi=soft")
set(CMAKE_ASM_FLAGS "--target=armv5te-none-eabi -mcpu=arm946e-s -marm -mfloat-abi=soft")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(PICOLIBC_LINK_FLAGS -nostdlib)
