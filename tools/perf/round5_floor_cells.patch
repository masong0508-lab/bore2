+// ---- BAKED GROUND CELLS (round 5, 8 MB). The ground storey of the city is cut into cells of 4 x 4 tiles on the map's even grid. What a
+// cell draws does not change until the map, its buildings, the window or the heights do: which tiles are a quad of their own and which
+// four make a 2x2 block's quad (the rule draw_layer's loops use), and where their corners stand (on the hills). That is worked out once
+// (fb_build, a cell a frame at most) into a compact list of the corners the cell's quads use (shared corners once) and the quads as four
+// indices each, and the tiles it takes are marked in fb_cov (the old loops leave them). A frame then runs a visible cell's corners through
+// the GTE three at a time straight from the cell (none built, none moved twice) and walks its quads: the same tests as the loops, a quad
+// close to the eye is still cut by the old path, and the shades still come from the floor-light cache (flc). Tiles the cell does not
+// take (water, indoors, under a roof) stay with the old loops. 2 MB: not used ----
+#define FB_C 4
+#define FB_G (FB_C + 1)
+#define FB_NX (MW / FB_C)
+#define FB_N (FB_NX * (MH / FB_C))
+typedef struct { u8 i[4], x, y, blk, pad; } FbQ;
+typedef struct { SVECTOR v[FB_G * FB_G] SVEC_ALIGN; FbQ q[FB_C * FB_C]; u8 nv, nq, pad[2]; } FbCell;
+static FbCell *fb_pool; static u8 (*fb_cov)[MW]; static int fb_up, fb_act;
+static u8 fb_has[FB_N]; static u32 fb_key[6] = { 0xffffffffu };
+int dbg_fb_cells, dbg_fb_quads, dbg_fb_built;
+static COLD void fb_build(FbCell *c, int cx, int cy, int hills) {
+    int X0 = cx * FB_C, Y0 = cy * FB_C; u8 vi[FB_G * FB_G]; memset(vi, 255, sizeof vi); c->nv = c->nq = 0;
+    for (int j = 0; j < FB_C; j += 2) for (int i = 0; i < FB_C; i += 2) {
+        int mx = X0 + i, my = Y0 + j, f0 = dfl[my][mx];
+        int ok = f0 != FL_WATER && !FL_NO4(f0) && dfl[my][mx + 1] == f0 && dfl[my + 1][mx] == f0 && dfl[my + 1][mx + 1] == f0;
+        int n = 0, ox[4], oy[4], sz[4];
+        if (ok) { if (!bld[my][mx] && !bld[my + 1][mx + 1]) { ox[0] = i; oy[0] = j; sz[0] = 2; n = 1; } }
+        else for (int t = 0; t < 4; t++) { int tx = mx + (t & 1), ty = my + (t >> 1); if (!bld[ty][tx] && dfl[ty][tx] != FL_WATER) { ox[n] = i + (t & 1); oy[n] = j + (t >> 1); sz[n] = 1; n++; } }
+        for (int q = 0; q < n; q++) {
+            FbQ *Q = &c->q[c->nq++]; Q->x = (u8)ox[q]; Q->y = (u8)oy[q]; Q->blk = (u8)(sz[q] == 2);
+            for (int k = 0; k < 4; k++) {
+                int gx = ox[q] + (k & 1) * sz[q], gy = oy[q] + (k >> 1) * sz[q], g = gy * FB_G + gx;
+                if (vi[g] == 255) { int h = hills ? gh_c(X0 + gx, Y0 + gy) : 0; SVECTOR *V = &c->v[c->nv]; vi[g] = c->nv++; V->vx = (short)((X0 + gx) * TILE); V->vy = (short)-h; V->vz = (short)-((Y0 + gy) * TILE); }
+                Q->i[k] = vi[g];
+            }
+            for (int dy = 0; dy < sz[q]; dy++) for (int dx = 0; dx < sz[q]; dx++) fb_cov[Y0 + oy[q] + dy][X0 + ox[q] + dx] = 1;
+        }
+    }
+}
