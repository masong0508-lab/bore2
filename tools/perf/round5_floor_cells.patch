+                int vx, vy, vz, r = blk ? 380 : 200;   // (a ball round the quad's middle, on the ground; the view's edges lean out 0.696 and 0.522 a unit of depth; the hills lift it up to hm)
+                if (blk) tile_view(tvF, mx, my, &vx, &vy, &vz); else tile_view(tvT, mx, my, &vx, &vy, &vz);
+                if (vz < Z_NEAR - r - 20 || ABS(vx) > ((vz * 89) >> 7) + r * 5 / 4 + 40 || ABS(vy) > ((vz * 67) >> 7) + r * 5 / 4 + hm + 40) continue;
+                gfx_floor_pass = 1; if (blk) floor_block(mx, my); else floor_tile(mx, my); gfx_floor_pass = 0; continue;
+            }
+            if (xv_outcode(A->x, A->y) & xv_outcode(B->x, B->y) & xv_outcode(C->x, C->y) & xv_outcode(Dd->x, Dd->y)) continue;   // (off the screen)
+            gfx_floor_pass = 1;
+            if (nc_need4(A, B, C, Dd)) { if (blk) floor_block(mx, my); else floor_tile(mx, my); gfx_floor_pass = 0; continue; }
+            { int fl = dfl[my][mx] % NFLOORS, sl = flc_slot(mx, my), tg = flc_tag[sl];
+              if ((tg & 0x3f) == flc_want(mx, my, blk)) {
+                  const TexRef *t = blk ? &fl_tex4[fl] : &fl_tex[fl];
+                  flc_emit(flc_sh[sl], tg >> 6, A, B, C, Dd, (u32)t->tpage << 16, t->u, t->v, blk ? 31 : 7); dbg_fb_quads++;
+              } else { if (blk) floor_block(mx, my); else floor_tile(mx, my); } }
+            gfx_floor_pass = 0;
+        }
+    }
+}
