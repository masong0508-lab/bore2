   Log_InfoPrintf("Running for %d frames...", s_frames_to_run);
 
+  {   // (the block keeps these out of the way of the gotos to cleanup)
+  struct Ev { int f, b; }; std::vector<Ev> evs; std::vector<int> shots; int off = -1; const int off0 = 1 << 24;   // (script times wait at off0 until the game starts)
+  {   // DSSCRIPT=<file>: lines "FRAME button" (held 8 frames) and "FRAME shot"; FRAME counts from the game's start (GAMESTART below)
+    static const char* names[16] = {"b", "y", "select", "start", "up", "down", "left", "right", "a", "x", "l", "r", "l2", "r2", "l3", "r3"};   // (as tools/lrrun.c: b = cross, a = circle, y = square, x = triangle)
+    static const int map[16] = {14, 15, 0, 3, 4, 6, 7, 5, 13, 12, 10, 11, 8, 9, 1, 2};   // (AnalogController::Button)
+    FILE* sf = getenv("DSSCRIPT") ? fopen(getenv("DSSCRIPT"), "r") : nullptr; char ln[160]; while (sf && fgets(ln, sizeof(ln), sf)) { int fr; char b[32]; if (sscanf(ln, "%d %31s", &fr, b) == 2) {
+        if (!strcmp(b, "shot")) shots.push_back(fr + off0);
+        else for (int i = 0; i < 16; i++) if (!strcmp(b, names[i])) evs.push_back({fr + off0, map[i]}); } }
+    if (sf) fclose(sf);
+  }
+  int held_until[32] = {0};
   for (u32 frame = 0; frame < s_frames_to_run; frame++)
