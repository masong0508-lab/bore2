+      for (auto& e : evs) e.f += off - off0; for (int& sh : shots) sh += off - off0; } }
+    for (auto& e : evs) if (e.f == (int)frame) held_until[e.b] = frame + 8;
+    if (Controller* c = Pad::GetController(0)) for (int i = 0; i < 16; i++) c->SetBindState(i, (int)frame < held_until[i] ? 1.0f : 0.0f);
+    for (int sh : shots) if (sh == (int)frame) g_host_display->WriteDisplayTextureToFile(RegTestHost::GetFrameDumpFilename(100000 + frame));
     System::RunFrame();
     Host::RenderDisplay(false);
     System::UpdatePerformanceCounters();
+    if ((frame % 100) == 0) fprintf(stderr, "PCLOG %u pc=%08x ra=%08x\n", frame, CPU::g_state.regs.pc, CPU::g_state.regs.ra);
   }
+  { FILE* f = fopen(getenv("DSRAM") ? getenv("DSRAM") : "/tmp/ds_ram.bin", "wb"); if (f) { fwrite(Bus::g_ram, 1, getenv("DS8MB") ? 8*1024*1024 : 2*1024*1024, f); fclose(f); } }
 
+  }
